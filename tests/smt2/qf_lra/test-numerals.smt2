(set-logic QF_LRA)
(set-option :incremental true)
(declare-const x Real)
(define-fun half ((y Real)) Real (/ y 2))
; without integers in the logic, numerals are reals
(assert (= x 0))
(assert (< x (+ x 1)))
(check-sat)
(push 1)
(assert (= (* 2 x) 1))
(check-sat)
(pop 1)
(assert (> (half 1) x))
(check-sat)
