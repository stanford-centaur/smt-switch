#ifndef SMT_SWITCH_TEST_PATHS_H
#define SMT_SWITCH_TEST_PATHS_H

#include <string_view>

namespace smt_tests {

// Raw string literals, so that a path arrives exactly as configure found it,
// backslashes and quotes included; configure refuses a path containing the
// )path" that would end one.

/** The directory holding the SMT-LIB reader's test inputs */
inline constexpr std::string_view smtlib_resource_dir =
    R"path(@SMTLIB_TEST_RESOURCE_DIR@)path";

// Each solver's own executable, or empty if configure found none
inline constexpr std::string_view bitwuzla_binary = R"path(@BITWUZLA_BINARY@)path";
inline constexpr std::string_view boolector_binary = R"path(@BOOLECTOR_BINARY@)path";
inline constexpr std::string_view cvc5_binary = R"path(@CVC5_BINARY@)path";
inline constexpr std::string_view mathsat_binary = R"path(@MATHSAT_BINARY@)path";
inline constexpr std::string_view yices2_binary = R"path(@YICES2_BINARY@)path";
inline constexpr std::string_view z3_binary = R"path(@Z3_BINARY@)path";

}  // namespace smt_tests

#endif  // SMT_SWITCH_TEST_PATHS_H
