@PACKAGE_INIT@

#[=======================================================================[.rst:
SmtSwitchConfig
---------------

Package configuration for smt-switch.

Provides ``SmtSwitch::smt-switch`` and, for each solver backend that was
built, ``SmtSwitch::smt-switch-<backend>``, as well as
``SmtSwitch::smt-switch-smtlib`` for the SMT-LIB reader if it was built.  The
available components, the backends and ``smtlib``, are listed in
``SmtSwitch_AVAILABLE_COMPONENTS``; asking for one that was not built is an
error, so::

    find_package(SmtSwitch REQUIRED COMPONENTS cvc5 btor smtlib)
    target_link_libraries(myprog SmtSwitch::smt-switch-cvc5
                                 SmtSwitch::smt-switch-smtlib)

Each backend pulls in its solver, so linking the backend alone is enough.

The backends are linked against the solver libraries this build found.  A
consumer therefore needs those solvers present, and the find modules that
locate them are installed next to this file.  A solver that the build found in
the prefix given for it, with ``--<solver>-dir`` or by default its copy under
``deps/``, is looked for in that prefix first.  A ``<Package>_ROOT`` set by the
external user, as a variable or in the environment, takes precedence.

One limitation.  The Boolector backend's own headers —
``smt-switch/boolector_solver.h`` and the three beside it, installed for
expert use — include Boolector's headers unqualified, and two of them reach
for internals that Boolector never installs at all.  Reaching the solver
through ``smt-switch/boolector_factory.h`` works as it should and is the
usual way; including one of the backend headers additionally requires
Boolector's own headers on the include path.

#]=======================================================================]

# find_package searches <Package>_ROOT only under CMP0074. Set before
# find_dependency is defined, as a macro runs under the policies in force
# where it was defined. find_package reads this file in a policy scope of its
# own, so the external user's setting is unaffected.
cmake_policy(SET CMP0074 NEW)
include(CMakeFindDependencyMacro)

set(SmtSwitch_AVAILABLE_COMPONENTS @SMT_SWITCH_AVAILABLE_COMPONENTS@)

# The find modules shipped alongside this file are what locate the solvers.
# Put them within reach of find_dependency, and take them back off afterwards
# so that a consumer's own module path is left as it was.
set(_smt_switch_saved_module_path "${CMAKE_MODULE_PATH}")
list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_LIST_DIR}")

# smt-switch links Threads privately, which a static consumer still has to
# satisfy.
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/SmtSwitchTargets.cmake")

# Each backend is a separate export set, loaded only when asked for. A build
# with every backend enabled would otherwise oblige a consumer who wants one
# solver to have all six installed.
foreach(_smt_switch_component IN LISTS SmtSwitch_FIND_COMPONENTS)
  if(NOT _smt_switch_component IN_LIST SmtSwitch_AVAILABLE_COMPONENTS)
    set(SmtSwitch_${_smt_switch_component}_FOUND FALSE)
    continue()
  endif()

  # The solver a backend needs, and the prefix it was found in when
  # smt-switch was built, empty if it was found elsewhere.
  set(_smt_switch_package "")
  set(_smt_switch_root "")
  set(_smt_switch_args "")
  set(_smt_switch_needs_gmp FALSE)
  if(_smt_switch_component STREQUAL "btor")
    set(_smt_switch_package Boolector)
    set(_smt_switch_root "@SMT_SWITCH_RECORDED_ROOT_Boolector@")
  elseif(_smt_switch_component STREQUAL "bitwuzla")
    set(_smt_switch_package Bitwuzla)
    set(_smt_switch_root "@SMT_SWITCH_RECORDED_ROOT_Bitwuzla@")
  elseif(_smt_switch_component STREQUAL "cvc5")
    set(_smt_switch_package cvc5)
    set(_smt_switch_root "@SMT_SWITCH_RECORDED_ROOT_cvc5@")
    set(_smt_switch_needs_gmp TRUE)
  elseif(_smt_switch_component STREQUAL "msat")
    set(_smt_switch_package MathSAT)
    set(_smt_switch_root "@SMT_SWITCH_RECORDED_ROOT_MathSAT@")
    set(_smt_switch_needs_gmp TRUE)
  elseif(_smt_switch_component STREQUAL "yices2")
    set(_smt_switch_package Yices2)
    set(_smt_switch_root "@SMT_SWITCH_RECORDED_ROOT_Yices2@")
    set(_smt_switch_needs_gmp TRUE)
  elseif(_smt_switch_component STREQUAL "z3")
    set(_smt_switch_package Z3)
    set(_smt_switch_root "@SMT_SWITCH_RECORDED_ROOT_Z3@")
    set(_smt_switch_args @SMT_SWITCH_Z3_DEPENDENCY_ARGS@)
  endif()

  if(NOT _smt_switch_package STREQUAL "")
    # The recorded prefix is the solver's root for this lookup only, unless
    # the external user set one.
    set(_smt_switch_hinted FALSE)
    if(
      NOT _smt_switch_root STREQUAL ""
      AND NOT DEFINED ${_smt_switch_package}_ROOT
      AND NOT DEFINED ENV{${_smt_switch_package}_ROOT}
    )
      set(${_smt_switch_package}_ROOT "${_smt_switch_root}")
      set(_smt_switch_hinted TRUE)
    endif()
    find_dependency(${_smt_switch_package} ${_smt_switch_args})
    if(_smt_switch_hinted)
      unset(${_smt_switch_package}_ROOT)
    endif()
  endif()
  if(_smt_switch_needs_gmp)
    find_dependency(GMP)
  endif()

  # Named apart from SmtSwitchTargets-*.cmake on purpose: the core targets
  # file globs that pattern to pick up its own per-configuration files, and
  # would drag every backend in with it.
  if(_smt_switch_component STREQUAL "smtlib")
    include("${CMAKE_CURRENT_LIST_DIR}/SmtSwitchSmtLibTargets.cmake")
  else()
    include("${CMAKE_CURRENT_LIST_DIR}/SmtSwitchBackendTargets-${_smt_switch_component}.cmake")
  endif()

  set(SmtSwitch_${_smt_switch_component}_FOUND TRUE)
endforeach()
unset(_smt_switch_component)
unset(_smt_switch_package)
unset(_smt_switch_root)
unset(_smt_switch_args)
unset(_smt_switch_needs_gmp)
unset(_smt_switch_hinted)

set(CMAKE_MODULE_PATH "${_smt_switch_saved_module_path}")
unset(_smt_switch_saved_module_path)

check_required_components(SmtSwitch)
