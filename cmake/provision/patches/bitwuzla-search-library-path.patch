Search LIBRARY_PATH when looking for a static CaDiCaL or Kissat.

Meson only tries `-lfoo` when looking for a shared library. For a static one
it searches the directories the compiler reports through --print-search-dirs.
GCC lists LIBRARY_PATH among those and Clang does not, so a static library
installed there is found with one compiler and missed with the other -- on
macOS Bitwuzla therefore builds the CaDiCaL from its own wrap instead of the
one already installed. Passing the directories explicitly evens that out.

--- a/src/meson.build
+++ b/src/meson.build
@@ -17,10 +17,24 @@
 
 # Subproject dependencies
 
+# Meson only tries `-lfoo` when looking for a shared library. For a static one
+# it searches the directories the compiler reports through --print-search-dirs,
+# and GCC lists LIBRARY_PATH among those while Clang does not, so a static
+# library installed there is found with one compiler and missed with the other.
+# Pass those directories explicitly so that both behave the same.
+library_path = run_command('sh', '-c', 'printf %s "$LIBRARY_PATH"',
+                           check: false).stdout()
+if library_path == ''
+  extra_library_dirs = []
+else
+  extra_library_dirs = library_path.split(':')
+endif
+
 # CaDiCaL does not provide pkg-config to find dependency
 cadical_dep = cpp_compiler.find_library('cadical',
                                         has_headers: ['cadical/cadical.hpp',
                                                       'cadical/tracer.hpp'],
+                                        dirs: extra_library_dirs,
                                         static: build_static,
                                         required: false)
 if not cadical_dep.found()
@@ -35,6 +49,7 @@
 # Kissat does not provide pkg-config to find dependency
 kissat_dep = cpp_compiler.find_library('kissat',
                                         has_headers: 'kissat.h',
+                                        dirs: extra_library_dirs,
                                         static: build_static,
                                         required: false)
 if not kissat_dep.found()
